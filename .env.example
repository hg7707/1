# Server
PORT=3000
NODE_ENV=production

# Leave empty in user-key mode. Users must provide their own SiliconFlow keys in the browser.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Public safety controls
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=80
TRUST_PROXY=true

# Users must submit their own SiliconFlow API keys from the browser.
# Set false only if you intentionally re-enable a server-owned key flow.
ALLOW_CLIENT_API_KEYS=true
